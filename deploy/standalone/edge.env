# =============================================================================
# Standalone / VM Runtime Configuration (Bare Linux / macOS)
# =============================================================================
# Precedence: nodes.yml < edge.env < Environment Variables

# Service Ports & Forwarding
MLX_LISTEN_HOST=192.168.1.64
MLX_PROXY_PORT=8080
MLX_SERVER_PORT=8030
MLX_UPSTREAM=http://127.0.0.1:8030

# Network Interface Selection (e.g. en1 on macOS Wi-Fi, en0 on Ethernet, eth0 on Linux)
MLX_NET_IFACE=en1

# Central Stack Endpoints (Must use LAN IP, Never Tailscale 100.x)
VICTORIA_METRICS_URL=http://192.168.1.64:8428/api/v1/write
MLX_OTLP_ENDPOINT=http://192.168.1.64:4318
MLX_OPIK_ENDPOINT=http://192.168.1.64:32173

# Feature Toggles
ENABLE_PROXY=true
ENABLE_HW_TELEMETRY=true
ENABLE_KV_AGENT=true
ENABLE_SUPERVISOR=true
ENABLE_LOGTAILER=true
ENABLE_PROCESS_PROFILER=true
ENABLE_SBOM_COLLECTOR=true
ENABLE_VMAGENT=true
