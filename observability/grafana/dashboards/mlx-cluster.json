{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "hide": false,
        "iconColor": "#e24d42",
        "name": "Alerts",
        "showIn": 0,
        "step": "60s",
        "textFormat": "{{labels.node}} {{labels.severity}}",
        "titleFormat": "ALERT: {{alertname}}",
        "type": "prometheus"
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Summary",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "count(up{job=\"mlx-hw\"} == 1)",
          "refId": "A"
        }
      ],
      "title": "Nodes online",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "req"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(increase(mlx_requests_total{job=\"mlx-proxy\", model=~\"$model\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Requests (5m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(increase(mlx_tokens_completion_total{job=\"mlx-proxy\", model=~\"$model\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Tokens out (5m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "tok/s"
        },
        "overrides": []
