    {
      "id": 49,
      "type": "stat",
      "title": "Nodes Throttling",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "count(mlx_hw_thermal_pressure > 0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "View firing alerts",
              "url": "/alerting/list?search=state:firing",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "count(mlx_hw_thermal_pressure > 0) - thermal_pressure is (100 - CPU_Scheduler_Limit)/100 from pmset -g therm, so ANY value > 0 means macOS is already limiting scheduler speed for heat right now."
    },
    {
