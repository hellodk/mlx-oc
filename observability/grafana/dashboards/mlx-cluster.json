        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(mlx_token_rate_tokens_per_second_sum{job=\"mlx-proxy\", model=~\"$model\"}[5m])) / sum(rate(mlx_token_rate_tokens_per_second_count{job=\"mlx-proxy\", model=~\"$model\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Avg tok/s",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(increase(mlx_tool_calls_total{job=\"mlx-proxy\", model=~\"$model\"}[5m]))",
          "refId": "A"
        }
