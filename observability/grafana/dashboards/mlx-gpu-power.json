{
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "type": "prometheus",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "60s",
        "iconColor": "#e24d42",
        "enable": true,
        "hide": false,
        "showIn": 0,
        "titleFormat": "ALERT: {{alertname}}",
        "textFormat": "{{labels.node}} {{labels.severity}}"
      }
    ]
  },
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "mlx",
    "gpu",
    "power"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "includeAll": true,
        "label": "Node",
        "name": "node",
        "query": "label_values(mlx_hw_load1, node)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
