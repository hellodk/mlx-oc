# Generated by Ansible (roles/mlx-observability) — mirror of
# observability/alertmanager/alertmanager.yml with webhook URLs and intervals
# from group_vars. vmalert sends fired alerts here via -notifier.url. The
# default receiver posts to a webhook; point it at your Slack/Teams/email
# bridge (or add a receiver of your choice).
#
# Inhibit rules: while a critical alert (e.g. the proxy is down) is firing,
# noisier subordinate alerts (upstream down, throughput drop) are silenced.
global:
  resolve_timeout: {{ obs_alertmanager_resolve_timeout }}

route:
  group_by: ["alertname", "node", "model"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: {{ obs_alertmanager_repeat_interval }}
  receiver: "default"
  routes:
    - matchers:
        - severity = critical
      receiver: "oncall"

receivers:
  - name: "oncall"
    webhook_configs:
      - url: "{{ obs_webhook_oncall }}"
        send_resolved: true

  - name: "default"
    webhook_configs:
      - url: "{{ obs_webhook_default }}"
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - alertname = "MLXProxyDown"
    target_matchers:
      - alertname =~ "MLXUpstreamDown|MLXThroughputDrop|MLXInferenceStalled"
    equal: ["job"]

  - source_matchers:
      - alertname =~ "MLXHardwareExporterDown"
    target_matchers:
      - alertname =~ "MLXGPUHighUtilization|MLXThermalThrottling|MLXLoadHigh"
    equal: ["node"]
