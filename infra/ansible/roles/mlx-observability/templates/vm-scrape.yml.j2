# VictoriaMetrics single-node scrape config.
# Generated by Ansible (roles/mlx-observability) from vm-scrape.yml.j2 —
# mirror of observability/vm-scrape.tmpl.yml. rank0 = serving node, rank1 =
# hw-telemetry peer; both are rendered from group_vars (obs_rank0_ip /
# obs_rank1_ip). The podman stack runs on the observability host and scrapes
# the MLX stack over the LAN.
# Targets:
#   - proxy      <rank0>:8080/metrics   (inference + hallucination metrics)
#   - hw agents  <rank0>:9102 and <rank1>:9102
#   - kv agent   <rank0>:9104           (KV cache + context-length gauges)
#   - supervisor <rank0>:9105           (model loaded / serving status)
#   - logtailer  <rank0>:9106           (log-streaming health)
global:
  scrape_interval: {{ obs_scrape_interval }}

scrape_configs:
  - job_name: mlx-proxy
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ obs_rank0_ip }}:8080"]
        labels:
          service: mlx-proxy
          node: rank0

  - job_name: mlx-hw
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ obs_rank0_ip }}:9102"
        labels:
          service: mlx-hw
          node: rank0
      - targets:
          - "{{ obs_rank1_ip }}:9102"
        labels:
          service: mlx-hw
          node: rank1

  - job_name: mlx-kv
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ obs_rank0_ip }}:9104"]
        labels:
          service: mlx-kv
          node: rank0

  # mlx_server_supervisor.py on rank 0: process/ready/model-serving status plus
  # restart + crash-reason counters. This is the source of truth for "is the
  # model actually loaded and serving right now?".
  - job_name: mlx-supervisor
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ obs_rank0_ip }}:9105"]
        labels:
          service: mlx-supervisor
          node: rank0

  # mlx_server_log_tailer.py on rank 0: server.log -> Opik log streaming
  # health (up / shipped / dropped / rate-limited). Source of truth for whether
  # log lines are actually reaching Opik.
  - job_name: mlx-logtailer
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ obs_rank0_ip }}:9106"]
        labels:
          service: mlx-logtailer
          node: rank0

{% if obs_sglang_enabled %}
  # Experimental / unverified: two independent sglang replicas (no ring/TP
  # backend on Apple Silicon). Native sglang:* Prometheus metrics, no proxy
  # sidecar needed. See sglang/ and README.md "SGLang (experimental)".
  - job_name: sglang
    scrape_interval: 15s
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ obs_rank0_ip }}:30000"
        labels:
          service: sglang
          node: rank0
          provider: "sglang"
      - targets:
          - "{{ obs_rank1_ip }}:30000"
        labels:
          service: sglang
          node: rank1
          provider: "sglang"
{% endif %}
