# Generated by Ansible (roles/mlx-observability) — mirror of
# observability/compose.yaml with images / ports / tunables from group_vars.
# Five containers on the observability host:
#   victoria-metrics + otel-collector + grafana + vmalert + alertmanager.
services:
  victoria-metrics:
    image: {{ obs_images.victoria_metrics }}
    container_name: victoria-metrics
    restart: unless-stopped
    ports:
      - "{{ obs_ports.vm }}"        # Prometheus-compatible API + /vmui query UI
    command:
      - -promscrape.config=/etc/vm-scrape.yml
      - -retentionPeriod={{ obs_vm_retention }}
      - -storageDataPath=/victoria-metrics-data
    volumes:
      - vm-data:/victoria-metrics-data
      - ./vm-scrape.yml:/etc/vm-scrape.yml:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:8428/health"]
      interval: 5s
      timeout: 3s
      retries: 20

  # OTLP gateway so the MLX proxy / hw agents can push traces, metrics and
  # logs (--otlp-endpoint http://<obs_host>:4318). Metrics are remote-written
  # into VictoriaMetrics; logs are appended to a JSONL file in the mlx-logs
  # volume; traces go to stdout.
  otel-collector:
    image: {{ obs_images.otel_collector }}
    container_name: otel-collector
    restart: unless-stopped
    # The file-exporter volume is root-owned inside the podman VM; run as root
    # so the logs pipeline can append its JSONL file (ephemeral stack).
    user: "0"
    ports:
      - "{{ obs_ports.otlp_grpc }}"   # OTLP gRPC
      - "{{ obs_ports.otlp_http }}"   # OTLP HTTP
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./otelcol-config.yaml:/etc/otelcol/config.yaml:ro
      - mlx-logs:/var/log/otelcol

  grafana:
    image: {{ obs_images.grafana }}
    container_name: grafana
    restart: unless-stopped
    ports:
      - "{{ obs_ports.grafana }}"
    environment:
      - GF_SECURITY_ADMIN_USER={{ obs_grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ obs_grafana_admin_password }}
      - GF_AUTH_ANONYMOUS_ENABLED={{ 'true' if obs_grafana_anonymous else 'false' }}
      - GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
      - GF_USERS_DEFAULT_THEME={{ obs_grafana_theme }}
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro

  # Alerting: vmalert evaluates the rule groups against VictoriaMetrics and
  # forwards fired alerts to Alertmanager. Active alerts are written back to
  # VM (`ALERTS` series) so Grafana can annotate them.
  vmalert:
    image: {{ obs_images.vmalert }}
    container_name: vmalert
    restart: unless-stopped
    ports:
      - "{{ obs_ports.vmalert }}"     # vmalert UI: /api/v1/alerts, /api/v1/rules
    command:
      - -datasource.url=http://victoria-metrics:8428
      - -remoteWrite.url=http://victoria-metrics:8428
      - -notifier.url=http://alertmanager:9093
      - -rule=/etc/vmalert/rules.yml
      - -httpListenAddr=:8880
    volumes:
      - ./vmalert/rules.yml:/etc/vmalert/rules.yml:ro
    depends_on:
      - victoria-metrics
      - alertmanager

  alertmanager:
    image: {{ obs_images.alertmanager }}
    container_name: alertmanager
    restart: unless-stopped
    ports:
      - "{{ obs_ports.alertmanager }}"   # Alertmanager UI / webhook config
    command: ["--config.file=/etc/alertmanager/alertmanager.yml"]
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro

volumes:
  vm-data:
  grafana-data:
  mlx-logs:
