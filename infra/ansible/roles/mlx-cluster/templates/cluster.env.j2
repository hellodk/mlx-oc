# Single source of truth for cluster-wide config — rendered by the mlx-cluster
# ansible role from group_vars/all/mlx-cluster.yml. Do not hand-edit; re-run
# the playbook (or the wizard) instead.
#
# cluster/start_server.sh sources this file directly and exports MLX_MODEL,
# so every child process it launches inherits it automatically.

MLX_MODEL={{ mlx_cluster.model_dir }}/{{ mlx_cluster.model_name }}

# --- Node topology (single source of truth: hosts.json) -----------------------
# hosts.json entry order IS the ring rank order; host[0] == rank 0 == the
# serving node. "ssh" is how this node reaches each peer (127.0.0.1 = local);
# "ips" are the ring mesh addresses. Path is relative to the repo root.
MLX_HOSTFILE=cluster/hosts.json

# LAN address the mlx_lm.server httpd binds on rank 0, and the proxy forwards
# to. Must be a local address on the serving node.
MLX_SERVER_IP={{ mlx_cluster.server_bind_ip }}
MLX_SERVER_PORT={{ mlx_cluster.ports.server }}

# How opencode / LAN clients reach the proxy (substituted into opencode.json
# by ./render-config.sh as __MLX_PROXY_URL__).
MLX_PROXY_URL=http://{{ mlx_cluster.server_bind_ip }}:{{ mlx_cluster.ports.proxy }}/v1

# Bind addresses for the per-component HTTP listeners.
MLX_PROXY_LISTEN=0.0.0.0:{{ mlx_cluster.ports.proxy }}
MLX_SUPERVISOR_LISTEN=0.0.0.0:{{ mlx_cluster.ports.supervisor }}
MLX_HW_LISTEN=0.0.0.0:{{ mlx_cluster.ports.hw }}
MLX_KV_LISTEN=0.0.0.0:{{ mlx_cluster.ports.kv }}
MLX_LOGTAILER_LISTEN=0.0.0.0:{{ mlx_cluster.ports.logtailer }}

# Ring interconnect subnet (for auto-detecting the ring interface in
# mlx_hw_telemetry.py: first iface with an address in this /24).
MLX_RING_SUBNET={{ mlx_cluster.ring_subnet }}

# Fallback temperature used by mlx_metrics_proxy.py when a request omits
# "temperature". Low by default: this cluster serves agentic/coding traffic,
# where determinism matters more than creative variance.
MLX_DEFAULT_TEMP={{ mlx_cluster.default_temp }}

# Token-confidence scoring in mlx_metrics_proxy.py (3 = top-3 candidates for
# entropy/margin; 0 disables scoring).
MLX_LOGPROBS={{ mlx_cluster.logprobs }}
MLX_LOGPROBS_STREAM_SAMPLE={{ mlx_cluster.logprobs_stream_sample }}
MLX_LOW_CONFIDENCE={{ mlx_cluster.low_confidence }}

# --- Proxy guardrails (mlx_metrics_proxy.py) -------------------------------
# MLX_API_KEY: if set, the proxy requires Authorization: Bearer <key> (401
# otherwise). Empty == auth disabled.
MLX_API_KEY={{ mlx_cluster.api_key | default('') }}

# Reject chat prompts longer than this (~tokens, estimated as chars/4).
MLX_MAX_PROMPT_TOKENS={{ mlx_cluster.max_prompt_tokens }}

# Clamp the client's max_tokens to this (also the default when omitted).
MLX_MAX_TOKENS_CAP={{ mlx_cluster.max_tokens_cap }}

# Reject request bodies larger than this (413).
MLX_MAX_BODY_BYTES={{ mlx_cluster.max_body_bytes }}

# Max chat requests per 10 s per client IP; 0 disables (429).
MLX_RATE_LIMIT={{ mlx_cluster.rate_limit }}

# OTLP gateway for traces/logs (empty disables).
MLX_OTLP_ENDPOINT={{ mlx_cluster.otlp_endpoint | default('') }}

# Opik observability endpoints (empty disables).
MLX_OPIK_OTLP_ENDPOINT={{ mlx_cluster.opik_otlp_endpoint | default('') }}
OPIK_BASE={{ mlx_cluster.opik_base | default('') }}
MLX_JUDGE_URL={{ mlx_cluster.judge_url | default('http://127.0.0.1:8080/v1') }}
