# Generated by Salt (observability/init.sls) — mirror of observability/vm-scrape.tmpl.yml.
# rank0 = serving node, rank1 = hw-telemetry peer; both rendered from the
# pillar (rank0_ip / rank1_ip). The podman stack runs on the observability
# host and scrapes the MLX stack over the LAN.
{%- set o = pillar.get('obs', {}) %}
{%- set rank0 = o.get('rank0_ip', '192.168.1.5') %}
{%- set rank1 = o.get('rank1_ip', '192.168.1.64') %}
{%- set interval = o.get('scrape_interval', '10s') %}
# Targets:
#   - proxy      <rank0>:8080/metrics   (inference + hallucination metrics)
#   - hw agents  <rank0>:9102 and <rank1>:9102
#   - kv agent   <rank0>:9104           (KV cache + context-length gauges)
#   - supervisor <rank0>:9105           (model loaded / serving status)
#   - logtailer  <rank0>:9106           (log-streaming health)
global:
  scrape_interval: {{ interval }}

scrape_configs:
  - job_name: mlx-proxy
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ rank0 }}:8080"]
        labels:
          service: mlx-proxy
          node: rank0

  - job_name: mlx-hw
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ rank0 }}:9102"
        labels:
          service: mlx-hw
          node: rank0
      - targets:
          - "{{ rank1 }}:9102"
        labels:
          service: mlx-hw
          node: rank1

  - job_name: mlx-kv
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ rank0 }}:9104"]
        labels:
          service: mlx-kv
          node: rank0

  # mlx_server_supervisor.py on rank 0: process/ready/model-serving status plus
  # restart + crash-reason counters. This is the source of truth for "is the
  # model actually loaded and serving right now?".
  - job_name: mlx-supervisor
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ rank0 }}:9105"]
        labels:
          service: mlx-supervisor
          node: rank0

  # mlx_server_log_tailer.py on rank 0: server.log -> Opik log streaming
  # health (up / shipped / dropped / rate-limited). Source of truth for whether
  # log lines are actually reaching Opik.
  - job_name: mlx-logtailer
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ rank0 }}:9106"]
        labels:
          service: mlx-logtailer
          node: rank0

{% if o.get('sglang_enabled', True) %}
  # Experimental / unverified: two independent sglang replicas (no ring/TP
  # backend on Apple Silicon). Native sglang:* Prometheus metrics, no proxy
  # sidecar needed. See sglang/ and README.md "SGLang (experimental)".
  - job_name: sglang
    scrape_interval: 15s
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ rank0 }}:30000"
        labels:
          service: sglang
          node: rank0
          provider: "sglang"
      - targets:
          - "{{ rank1 }}:30000"
        labels:
          service: sglang
          node: rank1
          provider: "sglang"
{% endif %}
