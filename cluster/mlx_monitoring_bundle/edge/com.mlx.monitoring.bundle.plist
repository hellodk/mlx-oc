<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mlx.monitoring.bundle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/path/to/mlx_monitoring_bundle/edge/mlx_monitoring_bundle.py</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/mlx_monitoring_bundle/edge</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/path/to/mlx_monitoring_bundle/edge/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/mlx_monitoring_bundle/edge/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MLX_MACBOOK_ID</key>
    <string>dk-mac</string>
  </dict>
</dict>
</plist>
