<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mlx.monitoring.bundle</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{VENV_PYTHON}}</string>
    <string>{{EDGE_DIR}}/mlx_monitoring_bundle.py</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{EDGE_DIR}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>{{EDGE_DIR}}/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{EDGE_DIR}}/logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MLX_DEVICE_ID</key>
    <string>{{DEVICE_ID}}</string>
  </dict>
</dict>
</plist>
