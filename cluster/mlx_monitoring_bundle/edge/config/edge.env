# Runtime overrides for a single edge node.
# Copy from config/edge.env.template and override per deployment.
#
# Central endpoints, node identity, model id and model path belong in
# config/nodes.yml. This file only contains runtime flags and local paths.

ENABLE_PROXY=true
ENABLE_HW_TELEMETRY=true
ENABLE_KV_AGENT=true
ENABLE_SUPERVISOR=true
ENABLE_LOGTAILER=true
ENABLE_VMAGENT=true

LOG_LEVEL=INFO
LOG_ROTATION_MAX_MB=50
LOG_ROTATION_BACKUPS=5

LOG_DIR=./logs
PID_DIR=./bin
CONFIG_DIR=./config

# Python that runs the monitoring exporters (needs pyyaml, prometheus_client,
# requests, opentelemetry, opik).
VENV_PYTHON=/Users/dk/bench/venv-mon/bin/python
# Python that has mlx_lm installed (runs the supervised server).
MLX_VENV_PYTHON=/Users/dk/venvs/mlx/bin/python

# mlx_lm.server endpoint. The proxy listens on :8080 and forwards here.
MLX_UPSTREAM=http://127.0.0.1:11234
MLX_SERVER_PORT=11234

# Adopt an already-healthy server instead of spawning a duplicate.
SUPERVISOR_ATTACH_HEALTHY=true
# Reject chat requests whose model id does not match the served model.
MLX_PROXY_STRICT_MODEL=true

# Leave empty to use the default-route interface (en1 on Wi-Fi, en0 on
# Ethernet). Set explicitly only when you need to monitor another link.
MLX_NET_IFACE=

# Podman container stats are meaningless on a Mac without podman.
ENABLE_CONTAINER_STATS=false

VMAGENT_SCRAPE_INTERVAL=10s
VMAGENT_QUEUE_CAPACITY=5000
VMAGENT_MAX_SHARDS=200
VMAGENT_BINARY=/Users/dk/bin/vmagent
