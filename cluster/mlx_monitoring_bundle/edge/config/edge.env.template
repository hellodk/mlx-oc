# Runtime overrides for a single edge node.
# Copy to config/edge.env and replace the paths.
#
# Central endpoints, node identity, model id and model path belong in
# config/nodes.yml. This file only contains runtime flags and local paths.

ENABLE_PROXY=true
ENABLE_HW_TELEMETRY=true
ENABLE_KV_AGENT=true
ENABLE_SERVER_MONITOR=true
ENABLE_LOGTAILER=true
ENABLE_PROCESS_PROFILER=true
ENABLE_SBOM_COLLECTOR=true
ENABLE_VMAGENT=true

LOG_LEVEL=INFO
LOG_ROTATION_MAX_MB=50
LOG_ROTATION_BACKUPS=5

LOG_DIR=./logs
PID_DIR=./bin
CONFIG_DIR=./config

# Python that runs the monitoring exporters (pyyaml, prometheus_client,
# requests, opentelemetry, opik).
VENV_PYTHON=<MONITORING_VENV>/bin/python

# External LLM server endpoint. The proxy listens on :8080 and forwards here.
MLX_UPSTREAM=http://127.0.0.1:11234

MLX_PROXY_STRICT_MODEL=false
MLX_LOGPROBS=3
MLX_LOGPROBS_STREAM_SAMPLE=0.0
MLX_LOW_CONFIDENCE=0.5
MAX_PROMPT_TOKENS=12000
MAX_TOKENS_CAP=4096
RATE_LIMIT=0
RATE_WINDOW=10.0

# Empty = default-route interface.
MLX_NET_IFACE=

ENABLE_CONTAINER_STATS=false

# Optional: server log location if not using the default ./logs/server.log
MLX_SERVER_LOG=

# Optional: passive process/external-supervisor monitoring overrides
MLX_PROCESS_PATTERN=mlx_lm.server
MLX_LAUNCHD_LABEL=
MLX_SYSTEMD_UNIT=

# VM agent scrape and buffer settings
VMAGENT_SCRAPE_INTERVAL=10s
VMAGENT_QUEUE_CAPACITY=5000
VMAGENT_MAX_SHARDS=200
VMAGENT_BINARY=vmagent

PROCESS_SAMPLE_INTERVAL=5.0
PROXY_LISTEN=127.0.0.1:8080
HW_LISTEN=127.0.0.1:9102
KV_LISTEN=127.0.0.1:9104
SUPERVISOR_LISTEN=127.0.0.1:9105
LOGTAILER_LISTEN=127.0.0.1:9106
PROCESS_LISTEN=127.0.0.1:9107
SBOM_SCAN_INTERVAL=3600.0
SBOM_LISTEN=127.0.0.1:9108
SBOM_BASE_DEVICE=
# Optional: directory path for durable disk buffer during central outage (empty = in-memory buffer only)
VMAGENT_PERSISTENT_QUEUE=

# OTLP scheme and TLS verification
OTLP_SCHEME=http
OTLP_VERIFY_TLS=false
