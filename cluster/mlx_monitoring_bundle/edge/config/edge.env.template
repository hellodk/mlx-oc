# edge.env.template
# =================
# Runtime overrides for a single edge node.
# Copy this file to config/edge.env and fill in your values.
#
# Precedence: config/nodes.yml < this file < actual environment variables.
#
# Only runtime flags live here. Node identity (id, serial, ip, ssh, role, model)
# and shared central endpoints live in config/nodes.yml.

# --- Central endpoints (host:port, from nodes.yml.override here if needed) ---
# CENTRAL_VICTORIA_METRICS=192.168.1.100:8428
# CENTRAL_OTEL=192.168.1.100:4318
# CENTRAL_OPIK=192.168.1.100:32173

# --- OTLP transport ---
# OTLP_SCHEME=http            # http | https
# OTLP_VERIFY_TLS=false       # true | false (verify server TLS certificate)

# --- Feature flags (enable/disable individual exporters) ---
ENABLE_PROXY=true
ENABLE_HW_TELEMETRY=true
ENABLE_KV_AGENT=true
ENABLE_SUPERVISOR=true
ENABLE_LOGTAILER=true

# --- Listen ports (override defaults: 8080, 9102, 9104, 9105, 9106) ---
# PROXY_LISTEN=0.0.0.0:8080
# HW_LISTEN=0.0.0.0:9102
# KV_LISTEN=0.0.0.0:9104
# SUPERVISOR_LISTEN=0.0.0.0:9105
# LOGTAILER_LISTEN=0.0.0.0:9106

# --- Proxy guardrails ---
MLX_LOGPROBS=1
MLX_LOGPROBS_STREAM_SAMPLE=0.1
MLX_LOW_CONFIDENCE=0.5
MAX_PROMPT_TOKENS=12000
MAX_TOKENS_CAP=4096
RATE_LIMIT=0
RATE_WINDOW=10.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_ROTATION_MAX_MB=50
LOG_ROTATION_BACKUPS=5

# --- Directories (relative to edge dir or absolute) ---
LOG_DIR=./logs
PID_DIR=./bin
CONFIG_DIR=./config

# --- Python venvs (configure to your installation) ---
VENV_PYTHON=/home/dk/.venv/bin/python
MLX_VENV_PYTHON=/home/dk/venvs/mlx/bin/python
MLX_LAUNCH=/home/dk/venvs/mlx/bin/mlx.launch

# --- VM agent ---
VMAGENT_SCRAPE_INTERVAL=10s
VMAGENT_QUEUE_CAPACITY=5000
VMAGENT_MAX_SHARDS=200

# --- MLX model (optional; if omitted, discovered from upstream GET /v1/models) ---
# MLX_MODEL=mlx-community/Qwen3.5-4B-MLX-8bit
