# Single source of truth for every edge node.
# Copy to config/nodes.yml and replace the placeholders.
#
# Precedence: this file < edge.env < actual environment variables.
#
# Every Mac is a standalone node: run the edge bundle locally on each machine.
# When exactly one enabled macbook is listed, it is selected automatically.
# Set MLX_MACBOOK_ID only when this file lists more than one node.

central:
  # Host running the central docker-compose stack.
  victoria_metrics: "<CENTRAL_HOST>:8428"
  otel: "<CENTRAL_HOST>:4318"
  opik: "<CENTRAL_HOST>:32173"

macbooks:
  - id: "<NODE_ID>"              # e.g. hostname; used as the macbook label
    serial: "<SERIAL_NUMBER>"    # system_profiler SPHardwareDataType
    ip: "<NODE_IP>"
    enabled: true
    # Optional. When both are set, the server is started from model_path's
    # parent and the model id is used for API requests.
    model: "<MODEL_ID>"
    model_path: "<MODEL_DIRECTORY>"
    # Optional list of model aliases accepted by strict model checking
    # model_aliases: ["alias-1", "alias-2"]
    # Optional per-node MLX server port override (default: 11234)
    # mlx_server_port: 11234
    # Optional per-node supervisor launch command override
    # mlx_server_cmd: ""
