      "includeVars": true,
      "keepTime": true,
      "title": "Device Detail",
      "tooltip": "Per-device serving and hardware deep dive",
      "type": "link",
      "url": "/d/mlx-detail"
    },
    {
      "icon": "bolt",
      "includeVars": true,
      "keepTime": true,
      "title": "Hardware",
      "tooltip": "CPU, GPU, RAM, Disk telemetry",
      "type": "link",
      "url": "/d/mlx-hardware"
    },
    {
      "icon": "process",
