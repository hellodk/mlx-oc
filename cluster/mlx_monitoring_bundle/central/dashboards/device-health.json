{
  "id": null,
  "uid": "mlx-device-health",
  "title": "MLX Device Health & Diagnostics",
  "tags": [
    "mlx",
    "fleet",
    "health",
    "diagnostics"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, macbook)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Healthy Nodes Online",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(count by (macbook) (mlx_hw_up == 1))",
          "legendFormat": "Online",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Degraded / Firing Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"MLX.*\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing Alerts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "SSH Connectivity (Fleet)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(mlx_ssh_up) or sum(mlx_hw_up)",
          "legendFormat": "SSH Reachable",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Panel 1: Fleet Availability Heatmap Matrix (Square Tiles)",
      "description": "Auto-scaling square tiles per discovered Mac. Click on any tile to drill down into Process Profiler or SBOM.",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "max by (macbook, instance) (mlx_hw_up)",
          "legendFormat": "{{macbook}} ({{instance}})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN / OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA",
                  "color": "semi-dark-gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.macbook}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.macbook}",
              "targetBlank": true
            },
            {
              "title": "\ud83d\udce6 Drilldown: Software Inventory (SBOM) for ${__field.labels.macbook}",
              "url": "/d/mlx-sbom-inventory?var-device=${__field.labels.macbook}",
              "targetBlank": true
            },
            {
              "title": "\ud83d\udcca Drilldown: Hardware Telemetry for ${__field.labels.macbook}",
              "url": "/d/detail?var-device=${__field.labels.macbook}",
              "targetBlank": true
            }
          ]
        }
      }
    },
    {
      "type": "state-timeline",
      "title": "Panel 2: Device Availability Over Time Period",
      "description": "Historical timeline blocks: Green (Available: 1), Red (Down: 0), Gray (No data / sleep)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "max by (macbook) (mlx_hw_up{macbook=~\"$device\"})",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No Telemetry",
                  "color": "semi-dark-gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Panel 3: Concurrent SSH Connectivity Validation (ssh -T 'hostname')",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_ssh_up{macbook=~\"$device\"} or mlx_hw_up{macbook=~\"$device\"}",
          "legendFormat": "{{macbook}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED (255)",
                  "color": "red"
                },
                "1": {
                  "text": "CONNECTED (0)",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    }
  ]
}