      "tooltip": "Packages, paths, versions, and drift delta",
      "type": "link",
      "url": "/d/mlx-sbom-inventory"
    },
    {
      "icon": "compass",
      "includeVars": true,
      "keepTime": true,
      "title": "Opik Traces",
      "tooltip": "LLM inference traces and token confidence",
      "type": "link",
      "url": "/d/mlx-opik"
    },
    {
      "icon": "bell",
      "includeVars": true,
      "keepTime": true,
      "title": "Alerts",
