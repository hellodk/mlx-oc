    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "definition": "label_values(mlx_hw_up, device)",
        "query": "label_values(mlx_hw_up, device)",
        "regex": "",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
