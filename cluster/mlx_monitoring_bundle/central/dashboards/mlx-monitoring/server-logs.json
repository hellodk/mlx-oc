      "description": "Devices with active log tailer daemons",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "count(mlx_log_tailer_up == 1) or vector(1)",
          "legendFormat": "",
