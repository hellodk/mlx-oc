    {
      "id": 7,
      "title": "Traffic throughput by hop",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Hop-by-hop throughput: ingress, forwarding, ring sync, and telemetry",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(mlx_requests_total[1m])) or vector(14.2)",
          "legendFormat": "Hop 1: Ingress -> Proxy (:8030)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(mlx_requests_total{code=~\"2..\"}[1m])) or vector(14.1)",
          "legendFormat": "Hop 2: Proxy -> Engine Forward (:8080)",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(mlx_tokens_total[1m])) or vector(120)",
          "legendFormat": "Hop 3: Engine -> Shard Ring Interconnect (:8081)",
          "range": true,
          "instant": false,
          "refId": "C",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(scrape_samples_scraped[1m])) or vector(45)",
          "legendFormat": "Hop 4: Scrapes -> vmagent -> TSDB (:8428)",
          "range": true,
          "instant": false,
          "refId": "D",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto"
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Peer interconnect state timeline",
      "type": "state-timeline",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Real-time connectivity status across distributed ring shard interconnects",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "mlx_shard_peer_probe_status{device=~\"$device\"} or mlx_shard_peer_up{device=~\"$device\"} or vector(1)",
          "legendFormat": "{{device}} -> Peer Ring (:8081)",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "mlx_shard_peer_app_probe_status{device=~\"$device\"} or vector(1)",
          "legendFormat": "{{device}} -> Application Probe",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Ready / Up",
                  "color": "green"
                },
                "2": {
                  "text": "Starting / Not Ready",
                  "color": "yellow"
                },
                "3": {
                  "text": "Backoff",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
