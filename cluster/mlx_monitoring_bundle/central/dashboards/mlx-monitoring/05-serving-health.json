        "definition": "label_values(mlx_requests_total, model)",
        "query": "label_values(mlx_requests_total, model)",
        "regex": "",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
