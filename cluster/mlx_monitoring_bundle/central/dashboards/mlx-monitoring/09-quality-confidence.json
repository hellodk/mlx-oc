          },
          "editorMode": "code",
          "expr": "mlx_token_topk_mass_mean{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "Top-k Mass",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
