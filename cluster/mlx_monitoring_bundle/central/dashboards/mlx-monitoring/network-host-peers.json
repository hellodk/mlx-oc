    {
      "id": 9,
      "title": "[Distributed Interconnect] Peer Ring Probe Status & RTT",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Peer-to-peer interconnect reachability and latency matrix separated from default host routing",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "(mlx_shard_peer_up{device=~\"$device\"} or mlx_shard_peer_probe_status{device=~\"$device\"}) or vector(1)",
          "legendFormat": "Status (1=Up, 0=Down)",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
