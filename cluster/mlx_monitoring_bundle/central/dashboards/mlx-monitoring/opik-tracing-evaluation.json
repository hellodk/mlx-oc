          "editorMode": "code",
          "expr": "rate(mlx_requests_total{device=~\"$device\", model=~\"$model\"}[1m])",
          "legendFormat": "Inference Requests/s",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "rate(mlx_confidence_scored_total{device=~\"$device\", model=~\"$model\"}[1m])",
          "legendFormat": "Scored Completions/s",
          "range": true,
          "instant": false,
          "refId": "B",
          "format": "time_series"
