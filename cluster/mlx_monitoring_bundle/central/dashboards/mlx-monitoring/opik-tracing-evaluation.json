        "uid": "VictoriaMetrics"
      },
      "description": "Total LLM chat completion requests instrumented with Opik distributed traces",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(mlx_requests_total[1h]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
