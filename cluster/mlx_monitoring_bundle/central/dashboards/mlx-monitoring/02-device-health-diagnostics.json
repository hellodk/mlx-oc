            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Missing Telemetry",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Devices configured in inventory but absent from current scrape series",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "count(count by (device) (absent(mlx_hw_up{device=~\"$device\"}))) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
