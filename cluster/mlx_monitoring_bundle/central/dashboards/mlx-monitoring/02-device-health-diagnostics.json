        "definition": "label_values(mlx_hw_up, device)",
        "query": "label_values(mlx_hw_up, device)",
        "regex": "",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
