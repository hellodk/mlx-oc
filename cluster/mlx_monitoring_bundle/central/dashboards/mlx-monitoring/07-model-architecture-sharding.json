          },
          "mappings": [],
          "links": []
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Topology Completeness",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Ratio of active reporting ranks to expected world size",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "((count(count by (rank) (mlx_shard_rank{device=~\"$device\"})) / (max(mlx_shard_world_size{device=~\"$device\"}) > 0)) * 100) or vector(100)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "mappings": [],
          "links": [],
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Peer Interconnect Reachability",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Success rate of peer interconnect TCP connect probes",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "((count((mlx_shard_peer_up == 1) or (mlx_shard_peer_probe_status == 1)) / (count(mlx_shard_peer_up or mlx_shard_peer_probe_status) > 0)) * 100) or vector(100)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Drill down",
              "url": "/d/mlx-mon-16-network-host-peers?${__all_variables}",
              "targetBlank": false
            }
          ],
          "decimals": 1
        },
        "overrides": []
      }
    },
