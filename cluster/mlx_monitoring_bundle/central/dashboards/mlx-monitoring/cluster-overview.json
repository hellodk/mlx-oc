    {
      "id": 9,
      "title": "Fleet status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Current device state (0=Down, 1=Ready, 2=Starting, 3=Backoff) and p95 TTFT",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "mlx_server_state{device=~\"$device\"}",
          "legendFormat": "Status",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "(histogram_quantile(0.95, sum(rate(mlx_ttft_seconds_bucket{device=~\"$device\"}[5m])) by (le, device))) or (0 * count by (device) (mlx_server_state{device=~\"$device\"}))",
          "legendFormat": "TTFT p95",
          "range": false,
          "instant": true,
          "refId": "B",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "mlx_model_info{attr=\"layer_count\", device=~\"$device\"}",
          "legendFormat": "Model",
          "range": false,
          "instant": true,
          "refId": "C",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
