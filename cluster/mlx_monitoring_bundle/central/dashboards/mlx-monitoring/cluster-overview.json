        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3.0
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Drill down",
              "url": "/d/mlx-inference-metrics?${__all_variables}",
              "targetBlank": false
            }
          ],
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
