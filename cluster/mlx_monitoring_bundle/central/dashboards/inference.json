{
  "id": null,
  "title": "MLX Inference Metrics",
  "tags": [
    "mlx",
    "inference"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, macbook)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "kind",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, kind)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Proxy Up",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "mlx_up{macbook=\"$device\"}",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "graph",
      "title": "Requests per Second",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_requests_total{macbook=\"$device\", kind=\"$kind\"}[1m])",
          "legendFormat": "{{macbook}} {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "graph",
      "title": "TTFT (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_ttft_seconds_bucket{macbook=\"$device\"}[5m]))",
          "legendFormat": "{{macbook}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Generation Time (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_generation_seconds_bucket{macbook=\"$device\"}[5m]))",
          "legendFormat": "{{macbook}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Token Rate (tok/s)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_token_rate_tokens_per_second_sum{macbook=\"$device\"}[1m]) / rate(mlx_token_rate_tokens_per_second_count{macbook=\"$device\"}[1m])",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "graph",
      "title": "Queue Wait (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_queue_wait_seconds_bucket{macbook=\"$device\"}[5m]))",
          "legendFormat": "{{macbook}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Prompt / Completion Tokens",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_tokens_prompt_total{macbook=\"$device\", kind=\"$kind\"}[1m])",
          "legendFormat": "{{macbook}} prompt {{kind}}",
          "refId": "A"
        },
        {
          "expr": "rate(mlx_tokens_completion_total{macbook=\"$device\", kind=\"$kind\"}[1m])",
          "legendFormat": "{{macbook}} completion {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "graph",
      "title": "Finish Reasons",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_finish_reason_total{macbook=\"$device\", kind=\"$kind\"}[5m])",
          "legendFormat": "{{macbook}} {{reason}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Tool Calls",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_tool_calls_total{macbook=\"$device\", kind=\"$kind\"}[5m])",
          "legendFormat": "{{macbook}} {{tool}} {{type}} {{kind}}",
          "refId": "A"
        }
      ]
    }
  ]
}
