{
  "id": null,
  "title": "MLX Inference Metrics",
  "tags": [
    "cluster",
    "inference",
    "mlx"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "kind",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, kind)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Proxy Up",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "mlx_up{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "graph",
      "title": "Requests per Second",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_requests_total{device=~\"$device\", kind=~\"$kind\"}[1m])",
          "legendFormat": "{{device}} {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "graph",
      "title": "TTFT (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_ttft_seconds_bucket{device=~\"$device\"}[5m]))",
          "legendFormat": "{{device}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Generation Time (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_generation_seconds_bucket{device=~\"$device\"}[5m]))",
          "legendFormat": "{{device}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Token Rate (tok/s)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_token_rate_tokens_per_second_sum{device=~\"$device\"}[1m]) / rate(mlx_token_rate_tokens_per_second_count{device=~\"$device\"}[1m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "graph",
      "title": "Queue Wait (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_queue_wait_seconds_bucket{device=~\"$device\"}[5m]))",
          "legendFormat": "{{device}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Prompt / Completion Tokens",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_tokens_prompt_total{device=~\"$device\", kind=~\"$kind\"}[1m])",
          "legendFormat": "{{device}} prompt {{kind}}",
          "refId": "A"
        },
        {
          "expr": "rate(mlx_tokens_completion_total{device=~\"$device\", kind=~\"$kind\"}[1m])",
          "legendFormat": "{{device}} completion {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "graph",
      "title": "Finish Reasons",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_finish_reason_total{device=~\"$device\", kind=~\"$kind\"}[5m])",
          "legendFormat": "{{device}} {{reason}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Tool Calls",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_tool_calls_total{device=~\"$device\"}[5m])",
          "legendFormat": "{{device}} {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prefill & Decode Throughput (tok/s)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(mlx_prefill_token_rate_tokens_per_second_sum{device=~\"$device\"}[1m]) / rate(mlx_prefill_token_rate_tokens_per_second_count{device=~\"$device\"}[1m])",
          "legendFormat": "Prefill rate ({{model}})",
          "refId": "A"
        },
        {
          "expr": "rate(mlx_decode_token_rate_tokens_per_second_sum{device=~\"$device\"}[1m]) / rate(mlx_decode_token_rate_tokens_per_second_count{device=~\"$device\"}[1m])",
          "legendFormat": "Decode rate ({{model}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tokens/s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Prefill & Decode Duration (p95)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(mlx_prefill_seconds_bucket{device=~\"$device\"}[5m]))",
          "legendFormat": "Prefill p95 ({{model}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(mlx_decode_seconds_bucket{device=~\"$device\"}[5m]))",
          "legendFormat": "Decode p95 ({{model}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "uid": "mlx-inference",
