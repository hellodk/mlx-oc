{
  "id": null,
  "title": "MLX Quality & Confidence",
  "tags": [
    "cluster",
    "confidence",
    "mlx",
    "quality"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_token_confidence_mean, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "model",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, model)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Hallucination Risk",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hallucination_risk{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Mean Token Confidence",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_confidence_mean{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Min Token Confidence",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_confidence_min{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Output Perplexity (p50 / p95 / Latest / Eval Ref)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mlx_output_perplexity_histogram_bucket{device=~\"$device\", model=~\"$model\"}[5m])) by (le, device, model))",
          "legendFormat": "{{device}} {{model}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(mlx_output_perplexity_histogram_bucket{device=~\"$device\", model=~\"$model\"}[5m])) by (le, device, model))",
          "legendFormat": "{{device}} {{model}} p50",
          "refId": "B"
        },
        {
          "expr": "mlx_output_perplexity{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{model}} latest",
          "refId": "C"
        },
        {
          "expr": "mlx_eval_perplexity{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{model}} eval_ref",
          "refId": "D"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Token Entropy (nats, p95 / tail-corrected / mean)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mlx_token_entropy_histogram_bucket{device=~\"$device\", model=~\"$model\"}[5m])) by (le, device, model))",
          "legendFormat": "{{device}} {{model}} p95",
          "refId": "A"
        },
        {
          "expr": "mlx_token_entropy_nats{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{model}} latest",
          "refId": "B"
        },
        {
          "expr": "mlx_token_entropy_tail_nats{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{model}} tail-corrected",
          "refId": "C"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Top-1 vs Top-2 Margin",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_margin_mean{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Low Confidence Token Ratio",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_low_confidence_token_ratio{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Confidence Std Dev",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_confidence_std{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Heuristic Signals",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_heuristic_repetition{device=~\"$device\"}",
          "legendFormat": "{{device}} repetition",
          "refId": "A"
        },
        {
          "expr": "mlx_heuristic_refusal{device=~\"$device\"}",
          "legendFormat": "{{device}} refusal",
          "refId": "B"
        },
        {
          "expr": "mlx_heuristic_hedging{device=~\"$device\"}",
          "legendFormat": "{{device}} hedging",
          "refId": "C"
        },
        {
          "expr": "mlx_heuristic_ungrounded{device=~\"$device\"}",
          "legendFormat": "{{device}} ungrounded",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Hallucination Flags (count)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_hallucination_flag_total{device=~\"$device\"}[5m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "graph",
      "title": "Token Confidence Distribution (p50 / p95 / Logprobs Coverage)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mlx_token_confidence_histogram_bucket{device=~\"$device\", model=~\"$model\"}[5m])) by (le, device, model))",
          "legendFormat": "{{device}} conf p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.05, sum(rate(mlx_token_confidence_histogram_bucket{device=~\"$device\", model=~\"$model\"}[5m])) by (le, device, model))",
          "legendFormat": "{{device}} conf p05 (low tail)",
          "refId": "B"
        },
        {
          "expr": "mlx_token_topk_mass_mean{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} top-k mass",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Canary Eval Accuracy & Expected Calibration Error (ECE)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_eval_overall_accuracy_ratio{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{model}} overall_acc",
          "refId": "A"
        },
        {
          "expr": "mlx_eval_accuracy_ratio{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{suite}}",
          "refId": "B"
        },
        {
          "expr": "mlx_eval_calibration_ece{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} calibration_ece",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Online Judge Accuracy (Opik Feedback Scores)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_judge_score{device=~\"$device\", model=~\"$model\"}",
          "legendFormat": "{{device}} {{criterion}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Logprobs Scoring Coverage & High-Perplexity Rate",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (device, source) (rate(mlx_confidence_scored_total{device=~\"$device\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{device}} scored ({{source}})",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(mlx_high_perplexity_responses_total{device=~\"$device\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{device}} high_ppl",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    }
  ],
  "uid": "mlx-quality",
