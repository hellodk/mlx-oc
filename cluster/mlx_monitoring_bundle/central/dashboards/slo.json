{
  "id": null,
  "title": "MLX SLO / Error Budget",
  "tags": [
    "mlx",
    "slo",
    "error-budget"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_requests_total, macbook)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "5xx Error Rate (1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (macbook) (rate(mlx_error_total{status=~\"5..\", macbook=~\"$macbook\"}[1h])) / sum by (macbook) (rate(mlx_requests_total{macbook=~\"$macbook\"}[1h]))",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        }
      }
    },
    {
      "type": "graph",
      "title": "Total Error Rate (4xx+5xx, 1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (macbook) (rate(mlx_error_total{macbook=~\"$macbook\"}[1h])) / sum by (macbook) (rate(mlx_requests_total{macbook=~\"$macbook\"}[1h]))",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3
        }
      }
    },
    {
      "type": "graph",
      "title": "Error Budget Remaining (5% target)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "1 - (sum by (macbook) (rate(mlx_error_total{status=~\"5..\", macbook=~\"$macbook\"}[1h])) / sum by (macbook) (rate(mlx_requests_total{macbook=~\"$macbook\"}[1h]))) / 0.05",
          "legendFormat": "{{macbook}} budget remaining",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Request Volume (1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (macbook) (rate(mlx_requests_total{macbook=~\"$macbook\"}[1h]))",
          "legendFormat": "{{macbook}} req/h",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "graph",
      "title": "5xx Errors Count (1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (macbook) (increase(mlx_error_total{status=~\"5..\", macbook=~\"$macbook\"}[1h]))",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Availability (1 - error rate, 1h)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "1 - sum by (macbook) (rate(mlx_error_total{status=~\"5..\", macbook=~\"$macbook\"}[1h])) / sum by (macbook) (rate(mlx_requests_total{macbook=~\"$macbook\"}[1h]))",
          "legendFormat": "{{macbook}} availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 4
        }
      }
    }
  ]
}
