{
  "id": null,
  "title": "MLX Network (Ring Interconnect)",
  "tags": [
    "cluster",
    "mlx",
    "network",
    "ring"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_net_rx_bytes_total, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_net_rx_bytes_total, node)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "iface",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_net_rx_bytes_total, iface)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "RX Bytes per Second",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(mlx_net_rx_bytes_total{device=~\"$device\", node=~\"$node\", iface=~\"$iface\"}[1m])",
          "legendFormat": "{{device}} {{iface}} rx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "TX Bytes per Second",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(mlx_net_tx_bytes_total{device=~\"$device\", node=~\"$node\", iface=~\"$iface\"}[1m])",
          "legendFormat": "{{device}} {{iface}} tx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "RX Errors",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(mlx_net_rx_errors_total{device=~\"$device\", node=~\"$node\", iface=~\"$iface\"}[5m])",
          "legendFormat": "{{device}} {{iface}} rx_err",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "TX Errors",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "rate(mlx_net_tx_errors_total{device=~\"$device\", node=~\"$node\", iface=~\"$iface\"}[5m])",
          "legendFormat": "{{device}} {{iface}} tx_err",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    }
  ],
