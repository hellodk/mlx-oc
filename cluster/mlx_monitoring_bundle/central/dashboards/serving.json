{
  "id": null,
  "title": "MLX Serving Health",
  "tags": [
    "cluster",
    "mlx",
    "serving"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_server_up, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Server Up",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "mlx_server_up{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Server Ready (/v1/models)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "mlx_server_ready{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "Model Loaded",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "mlx_model_loaded{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{model}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "Restarts (15m)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "increase(mlx_server_restarts_total{device=~\"$device\"}[15m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Server State (0=down 1=running_ready 2=up_not_ready 3=backoff)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_state{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3
        }
      }
    },
    {
      "type": "graph",
      "title": "Server Uptime",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_uptime_seconds{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Crashes by Reason",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_crashes_total{device=~\"$device\"}",
          "legendFormat": "{{device}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Last Exit Code",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_last_exit_code{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Health Checks (ok vs fail)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_server_health_checks_total{device=~\"$device\"}[5m])",
          "legendFormat": "{{device}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Backoff Seconds",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_backoff_seconds{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    }
  ],
  "uid": "mlx-serving",
  "links": [
    {
