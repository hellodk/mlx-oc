{
  "id": null,
  "title": "MLX Hardware Telemetry",
  "tags": [
    "cluster",
    "hardware",
    "mlx"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, node)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "CPU Load Average",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_load1{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} load1",
          "refId": "A"
        },
        {
          "expr": "mlx_hw_load5{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} load5",
          "refId": "B"
        },
        {
          "expr": "mlx_hw_load15{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} load15",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83c\udf10 Drilldown: Network & Thunderbolt Interconnect",
              "url": "/d/mlx-network?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "CPU Count",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_cpu_count{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83c\udf10 Drilldown: Network & Thunderbolt Interconnect",
              "url": "/d/mlx-network?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Memory Used vs Total",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_mem_used_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} used",
          "refId": "A"
        },
        {
          "expr": "mlx_hw_mem_total_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83c\udf10 Drilldown: Network & Thunderbolt Interconnect",
              "url": "/d/mlx-network?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Free Pages (Pressure)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_mem_pressure{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Disk Used vs Total",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_disk_used_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} used",
          "refId": "A"
        },
        {
          "expr": "mlx_hw_disk_total_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "graph",
      "title": "GPU Memory (IOKit)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_gpu_mem_used_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} used",
          "refId": "A"
        },
        {
          "expr": "mlx_hw_gpu_mem_alloc_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} alloc",
          "refId": "B"
        },
        {
          "expr": "mlx_hw_gpu_mem_total_bytes{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} total",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83c\udf10 Drilldown: Network & Thunderbolt Interconnect",
              "url": "/d/mlx-network?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "CPU Temperature",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_cpu_temp_celsius{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83c\udf10 Drilldown: Network & Thunderbolt Interconnect",
              "url": "/d/mlx-network?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Uptime",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 6,
        "y": 18,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_uptime_seconds{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "graph",
      "title": "Exporter Up",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_up{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    }
  ],
