{
  "id": null,
  "title": "MLX Cluster Overview",
  "tags": [
    "cluster",
    "mlx",
    "overview"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, node)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Devices Online",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(count by (device) (mlx_hw_up))",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health & Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests / sec (cluster)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(rate(mlx_requests_total{device=~\"$device\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg Token Rate (tok/s)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "avg(rate(mlx_token_rate_tokens_per_second_sum{device=~\"$device\"}[1m]) / rate(mlx_token_rate_tokens_per_second_count{device=~\"$device\"}[1m]))",
          "legendFormat": "tok/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "5xx Error Rate",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "(sum(rate(mlx_error_total{status=~\"5..\", device=~\"$device\"}[5m])) / (sum(rate(mlx_requests_total{device=~\"$device\"}[5m])) > 0)) or vector(0)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Request Rate by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_requests_total{device=~\"$device\"}[1m])",
          "legendFormat": "{{device}} ({{model}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\u26a1 Drilldown: Inference Metrics for ${__field.labels.device}",
              "url": "/d/mlx-inference?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83d\udd0d Drilldown: Opik Tracing for ${__field.labels.device}",
              "url": "/d/mlx-opik?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Server Up / Ready by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_up{device=~\"$device\"}",
          "legendFormat": "{{device}} up",
          "refId": "A"
        },
        {
          "expr": "mlx_server_ready{device=~\"$device\"}",
          "legendFormat": "{{device}} ready",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health & Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "GPU Utilization by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_gpu_utilization_percent{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 100,
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83d\udcbb Drilldown: Hardware Telemetry for ${__field.labels.device}",
              "url": "/d/mlx-hardware?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Thermal Pressure by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_thermal_pressure{device=~\"$device\", node=~\"$node\"}",
          "legendFormat": "{{device}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "links": [
            {
              "title": "\u26a1 Drilldown: Top 10 Process Profiler for ${__field.labels.device}",
              "url": "/d/mlx-process-profiler?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\ud83d\udcbb Drilldown: Hardware Telemetry for ${__field.labels.device}",
              "url": "/d/mlx-hardware?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Hallucination Risk by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hallucination_risk{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Mean Token Confidence by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_confidence_mean{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    }
  ],
  "uid": "mlx-overview",
  "links": [
