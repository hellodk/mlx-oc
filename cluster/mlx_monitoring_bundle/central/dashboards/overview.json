{
  "id": null,
  "title": "MLX Cluster Overview",
  "tags": [
    "mlx",
    "cluster",
    "overview"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, macbook)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(mlx_hw_up, node)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Macbooks Online",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(count by (macbook) (mlx_hw_up))",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests / sec (cluster)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(rate(mlx_requests_total{macbook=~\"$macbook\", node=~\"$node\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg Token Rate (tok/s)",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "avg(rate(mlx_token_rate_tokens_per_second_sum{macbook=~\"$macbook\"}[1m]) / rate(mlx_token_rate_tokens_per_second_count{macbook=~\"$macbook\"}[1m]))",
          "legendFormat": "tok/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "type": "stat",
      "title": "5xx Error Rate",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(rate(mlx_error_total{status=~\"5..\", macbook=~\"$macbook\"}[5m])) / sum(rate(mlx_requests_total{macbook=~\"$macbook\"}[5m]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Request Rate by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(mlx_requests_total{macbook=~\"$macbook\", node=~\"$node\"}[1m])",
          "legendFormat": "{{macbook}} / {{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Server Up / Ready by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_server_up{macbook=~\"$macbook\"}",
          "legendFormat": "{{macbook}} up",
          "refId": "A"
        },
        {
          "expr": "mlx_server_ready{macbook=~\"$macbook\"}",
          "legendFormat": "{{macbook}} ready",
          "refId": "B"
        }
      ]
    },
    {
      "type": "graph",
      "title": "GPU Utilization by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_gpu_utilization_percent{macbook=~\"$macbook\", node=~\"$node\"}",
          "legendFormat": "{{macbook}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "graph",
      "title": "Thermal Pressure by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hw_thermal_pressure{macbook=~\"$macbook\", node=~\"$node\"}",
          "legendFormat": "{{macbook}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Hallucination Risk by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_hallucination_risk{macbook=~\"$macbook\"}",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    },
    {
      "type": "graph",
      "title": "Mean Token Confidence by Macbook",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "mlx_token_confidence_mean{macbook=~\"$macbook\"}",
          "legendFormat": "{{macbook}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      }
    }
  ]
}
