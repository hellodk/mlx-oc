{
  "id": null,
  "title": "MLX Alerts",
  "tags": [
    "alerts",
    "cluster",
    "mlx"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(ALERTS, device)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "severity",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(ALERTS, severity)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "alertname",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(ALERTS, alertname)",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "graph",
      "title": "Active Alerts by Device",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"MLX.*\", device=~\"$device\", severity=~\"$severity\"}",
          "legendFormat": "{{alertname}} {{severity}} {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Critical Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"MLX.*\", device=~\"$device\", severity=\"critical\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "critical",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Warning Alerts",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"MLX.*\", device=~\"$device\", severity=\"warning\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "warning",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "graph",
      "title": "Alert State Over Time",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"MLX.*\", device=~\"$device\"}",
          "legendFormat": "{{alertname}} {{device}} {{alertstate}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Active Alert Details",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"MLX.*\", device=~\"$device\", severity=~\"$severity\", alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "\ud83d\udcca Drilldown: Per-Device Detail for ${__field.labels.device}",
              "url": "/d/mlx-detail?var-device=${__field.labels.device}",
              "targetBlank": false
            },
            {
              "title": "\u26a1 Drilldown: Device Health Matrix",
              "url": "/d/mlx-device-health?var-device=${__field.labels.device}",
              "targetBlank": false
            }
          ]
        }
      }
    }
  ],
  "uid": "mlx-alerts",
