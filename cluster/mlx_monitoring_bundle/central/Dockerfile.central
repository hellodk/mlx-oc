FROM alpine:3.20

# Central stack config image: packages otel-collector, alertmanager,
# vmalert rules, and grafana dashboards into /etc/mlx-monitoring/central.
WORKDIR /etc/mlx-monitoring/central

COPY config/ ./config/
COPY dashboards/ ./dashboards/

RUN chmod -R a+rX . && \
    find . -type d -exec chmod a+rx {} +

CMD ["true"]
