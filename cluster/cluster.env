# Single source of truth for cluster-wide config.
#
# cluster/start_server.sh sources this file directly and exports MLX_MODEL,
# so every child process it launches (mlx_server_supervisor.py,
# mlx_metrics_proxy.py, mlx_kv_cache_agent.py) inherits it automatically.
# Every standalone script under cluster/ and tools/ also reads MLX_MODEL as
# its default (os.environ.get("MLX_MODEL", "<last-known-good>")), so it picks
# up the right value even when run outside start_server.sh, as long as this
# file was sourced first (e.g. `source cluster/cluster.env && python3 tools/bench.py`).
#
# opencode.json is generated from opencode.json.tmpl by ./render-config.sh,
# which also reads MLX_MODEL from here.
#
# To change the model: edit this line, restart the stack, re-run
# ./render-config.sh. Nothing else in the repo should hardcode a model id.
MLX_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit

# --- Node topology (single source of truth: hosts.json) -----------------------
#
# The whole stack (mlx_lm.server + supervisor + proxy + kv-agent + logtailer)
# runs on rank 0; every other entry in hosts.json is a ring peer that helps
# with prefill and runs hw telemetry. hosts.json entry order IS the ring rank
# order, so for an N-node ring list all N hosts, first = serving node:
#
#   {
#     "backend": "ring",
#     "hosts": [
#       {"ssh": "127.0.0.1", "ips": ["192.168.2.2"]},   # rank 0 = serving node
#       {"ssh": "192.168.2.1", "ips": ["192.168.2.1"]}  # rank 1..N-1 = peers
#     ]
#   }
#
# "ssh" is how this node reaches each peer (127.0.0.1 = local). "ips" are the
# ring mesh addresses. start_server.sh derives rank IPs / peer list from this
# file, so no IP is hardcoded in the scripts. Path is relative to the repo root.
MLX_HOSTFILE=cluster/hosts.json

# LAN address the mlx_lm.server httpd binds on rank 0, and the proxy forwards
# to. Must be a local address on the serving node and reachable by the proxy,
# opencode and LAN clients. Defaults to 127.0.0.1 if unset.
MLX_SERVER_IP=192.168.1.5
MLX_SERVER_PORT=8081

# How opencode / LAN clients reach the proxy (substituted into opencode.json
# by ./render-config.sh as __MLX_PROXY_URL__).
MLX_PROXY_URL=http://192.168.1.5:8080/v1

# Bind addresses for the per-component HTTP listeners.
MLX_PROXY_LISTEN=0.0.0.0:8080
MLX_SUPERVISOR_LISTEN=0.0.0.0:9105
MLX_HW_LISTEN=0.0.0.0:9102
MLX_KV_LISTEN=0.0.0.0:9104
MLX_LOGTAILER_LISTEN=0.0.0.0:9106

# Ring interconnect subnet (for auto-detecting the ring interface in
# mlx_hw_telemetry.py: first iface with an address in this /24).
MLX_RING_SUBNET=192.168.2

# Fallback temperature used by mlx_metrics_proxy.py when a request omits
# "temperature". Low by default: this cluster serves agentic/coding traffic,
# where determinism (fewer hallucinated tool calls, reproducible benchmarks)
# matters more than creative variance. Per-request "temperature" in the
# request body always overrides this — it's a default, not a cap.
MLX_DEFAULT_TEMP=0.0

# Token-confidence scoring in mlx_metrics_proxy.py.
#
# MLX_LOGPROBS is the number of top candidates the proxy asks the upstream for
# on requests that did not ask for logprobs themselves. It is what feeds
# mlx_output_perplexity / mlx_token_entropy_nats / mlx_token_confidence_*.
# The proxy strips the field back out before the client sees the response, so
# this is invisible to opencode. 0 disables scoring entirely.
# 3 is enough for entropy and top-1 vs top-2 margin without bloating the
# upstream response.
MLX_LOGPROBS=3

# mlx_lm.server only returns logprobs on NON-streaming responses. Everything
# real (opencode, every bench tool) streams, so without this the scored
# population is empty. This is the fraction of streaming requests the proxy
# runs non-streamed so it can score them - same single generation, same GPU
# cost, but that one response arrives all at once instead of token by token.
# 0.05 == one in twenty. Raise it while investigating, drop it to 0 to stop.
MLX_LOGPROBS_STREAM_SAMPLE=0.05

# Token probability below which a token counts as "low confidence" for
# mlx_low_confidence_token_ratio and mlx_low_confidence_response_total.
MLX_LOW_CONFIDENCE=0.5

# --- Proxy guardrails (mlx_metrics_proxy.py) -------------------------------
#
# MLX_API_KEY: if set, the proxy requires `Authorization: Bearer <key>` on
# every request (401 otherwise). Empty == auth disabled. Set a value to lock
# down the :8080 endpoint.
MLX_API_KEY=

# Reject chat prompts longer than this (~tokens, estimated as chars/4). This
# is the guardrail that stopped the 17,667-token-prompt Metal OOM crash. rank0
# is the 16 GiB Mac mini B since 2026-08-10; the cap is deliberately kept
# conservative because prompt-cache + KV still share that 16 GiB.
MLX_MAX_PROMPT_TOKENS=16000

# Clamp the client's max_tokens to this (also the default when omitted), so a
# single request can never decode without bound and hold the GPU hostage.
MLX_MAX_TOKENS_CAP=4096

# Reject request bodies larger than this (413).
MLX_MAX_BODY_BYTES=4194304

# Max chat requests per 10 s per client IP; 0 disables (429). Set e.g. 60 to
# blunt runaway client loops while leaving room for benches.
MLX_RATE_LIMIT=0

# OTLP gateway for traces/logs. The in-cluster otel-gateway NodePort forwards
# traces to Tempo; the compose collector discards them (exporters: [debug]).
MLX_OTLP_ENDPOINT=http://192.168.1.10:30318

# Opik observability endpoints (proxy + opik_evaluator). Override per-run when
# running off the cluster LAN.
MLX_OPIK_OTLP_ENDPOINT=http://192.168.1.10:32173/api/v1/private/otel
OPIK_BASE=http://192.168.1.10:32173
MLX_JUDGE_URL=http://127.0.0.1:8080/v1
